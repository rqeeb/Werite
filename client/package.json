{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch --hot src/index.ts",
    "build": "bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --public-path=/ --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "start": "NODE_ENV=production bun src/index.ts"
  },
  "dependencies": {
    "@types/axios": "^0.14.4",
    "@types/dotenv": "^8.2.3",
    "axios": "^1.19.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.28.0",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7.18.2",
    "react-toastify": "^11.1.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bun": "latest"
  }
}
